  "preload_source": [
    "import childProcess from 'node:child_process';",
    "import {openSync,closeSync,writeSync} from 'node:fs';",
    "import {syncBuiltinESMExports} from 'node:module';",
    "const originalSpawn=childProcess.spawn;",
    "childProcess.spawn=function(...args) {",
    "  if(!Array.isArray(args[1]) || !args[1].includes('--worker')) {",
    "    return Reflect.apply(originalSpawn,this,args);",
    "  }",
    "  const held=[];",
    "  let exhausted=false;",
    "  let kid;",
    "  let thrown;",
    "  try {",
    "    for(;;) {",
    "      try { held.push(openSync('/dev/null','r')); }",
    "      catch(error) {",
    "        if(error.code!=='EMFILE') throw error;",
    "        exhausted=true;",
    "        break;",
    "      }",
    "    }",
    "    kid=Reflect.apply(originalSpawn,this,args);",
    "    return kid;",
    "  } catch(error) {",
    "    thrown=error;",
    "    throw error;",
    "  } finally {",
    "    for(const fd of held) closeSync(fd);",
    "    writeSync(2,JSON.stringify({diagnostic:'real-worker-spawn',exhausted,held:held.length,pid:kid?.pid,stdinAbsent:kid?.stdin===undefined||kid?.stdin===null,thrown:thrown?.code})+'\\n');",
    "  }",
    "};",
    "syncBuiltinESMExports();",
    "writeSync(2,JSON.stringify({diagnostic:'spawn-preload-installed',pid:process.pid})+'\\n');"
  ],
