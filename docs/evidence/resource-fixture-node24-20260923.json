    "const require=createRequire(join(repo,'package.json'));",
    "const cli=require.resolve('tsx/cli');",
    "const quote=s=>`'${s.replace(/'/g, `'\\\\''`)}'`;",
    "console.log(JSON.stringify({root,node:process.version,execPath:process.execPath,cli}));",
    "for(const cap of [128]) {",
    " const dir=join(root,`cap-${cap}`);",
    " mkdirSync(join(dir,'scripts','check'),{recursive:true});",
    " mkdirSync(join(dir,'docs'),{recursive:true});",
    " writeFileSync(join(dir,'docs','requirements.json'),JSON.stringify({requirements:[{id:'X1',accept:[{id:'X1.a'}]}]}));",
    " writeFileSync(join(dir,'scripts','check','a.ts'),Array.from({length:40},(_,i)=>`export const k${i} = 'keep'`).join('\\n')+'\\n');",
    " writeFileSync(join(dir,'scripts','test.ts'),\"import * as a from './check/a.js'\\nconst bad = Object.values(a).filter(v => v !== 'keep').length\\nif (bad) { console.log('\\\\n' + bad + ' 个失败\\\\n'); process.exitCode = 1 }\\n\");",
    " writeFileSync(join(dir,'scripts','check','mutations.json'),JSON.stringify({mutations:Array.from({length:40},(_,i)=>({id:`M-J-fd${i}`,req:'X1.a',why:'把那个值改掉，测试该红',file:'scripts/check/a.ts',find:`k${i} = 'keep'`,replace:`k${i} = 'gone'`})),exemptions:[]}));",
    " const env={...process.env,TIKHUB_API_KEY:'fake-key-for-selfcheck',NODE_OPTIONS:`--import file:///tmp/kol-fd-at-worker-spawn.mjs --import ${JSON.stringify(pathToFileURL(join(repo,'scripts/check/fake-fetch.ts')).href)}`};",
    " const cmd=`ulimit -n ${cap}; exec ${[process.execPath,cli,join(repo,'scripts/check/mutate.ts'),'--jobs=32'].map(quote).join(' ')}`;",
    " const r=spawnSync('/bin/sh',['-c',cmd],{cwd:dir,env,detached:true,encoding:'utf8'});",
    " const ps=spawnSync(\"/bin/ps\",[\"-axo\",\"pid=,ppid=,pgid=,command=\"],{encoding:\"utf8\"}); const leftovers=ps.stdout.split(\"\\n\").filter(line=>Number(line.trim().split(/\\s+/)[2])===r.pid); console.log(JSON.stringify({cap,processGroup:r.pid,leftovers,psStatus:ps.status}));",
    " const out=(r.stdout??'')+(r.stderr??'');",
    " writeFileSync(join(root,`cap-${cap}.log`),out);",
    " console.log(JSON.stringify({cap,status:r.status,signal:r.signal,error:r.error?.message,left:existsSync(join(dir,'.check-cache/mutate-jobs')),output:out}));",
    "}"
