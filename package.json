{
  "name": "kol-outreach-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/probe.ts",
    "collect": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/collect.ts",
    "enrich": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/enrich.ts",
    "render": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/render.ts",
    "test": "tsx scripts/test.ts",
    "lint": "tsx scripts/check/lint.ts",
    "size": "tsx scripts/check/size.ts",
    "age": "tsx scripts/check/age.ts",
    "spec": "tsx scripts/check/spec-sync.ts",
    "adr": "tsx scripts/check/adr-sync.ts",
    "arch": "tsx scripts/check/arch-sync.ts",
    "mutate": "tsx scripts/check/mutate.ts",
    "formal": "tsx scripts/check/formal.ts",
    "selfcheck": "tsx scripts/check/selfcheck.ts",
    "audit": "tsx scripts/check/audit.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run size && npm run age && npm run spec && npm run adr && npm run arch && npm run typecheck && npm test && npm run mutate && npm run formal && npm run selfcheck && npm run audit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
