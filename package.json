{
  "name": "kol-outreach-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/probe.ts",
    "probe:ig-paging": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/probe-ig-paging.ts",
    "collect": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/collect.ts",
    "enrich": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/enrich.ts",
    "render": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/render.ts",
    "feedback-template": "node --import tsx scripts/feedback-template.ts",
    "test": "node --import tsx scripts/test.ts",
    "size": "node --import tsx scripts/check/size.ts",
    "spec": "node --import tsx scripts/check/spec-sync.ts",
    "adr": "node --import tsx scripts/check/adr-sync.ts",
    "mutate": "node --import tsx scripts/check/mutate.ts",
    "selfcheck": "node --import tsx scripts/check/selfcheck.ts",
    "audit": "node --import tsx scripts/check/audit.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run size && npm run spec && npm run adr && npm run typecheck && npm test && npm run mutate && npm run selfcheck && npm run audit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
